{
  "name": "whatsapp-linux-app",
  "version": "1.3.0",
  "description": "An Unofficial desktop app for Whatsapp",
  "main": "main.js",
  "desktopName": "whatsapp-linux-app.desktop",
  "homepage": "https://apps.himelrana.com/whatsapp",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "asar": true,
    "appId": "com.himelrana.snap.whatsapp",
    "directories": {
      "buildResources": "."
    },
    "files": [
      "main.js",
      "package.json",
      "icon.png"
    ],
    "linux": {
      "target": [
        "snap",
        "deb"
      ],
      "icon": "./icon.png",
      "category": "Network;TextTools;Office;GTK;GNOME",
      "syncDesktopName": true
    },
    "snap": {
      "confinement": "strict",
      "grade": "stable",
      "summary": "Linux Client for Whatsapp",
      "plugs": [
        "desktop",
        "desktop-legacy",
        "home",
        "x11",
        "unity7",
        "browser-support",
        "network",
        "gsettings",
        "opengl",
        "audio-playback",
        "audio-record",
        "camera"
      ]
    },
    "deb": {
      "icon": "./icon.png",
      "category": "Network;TextTools;Office;GTK;GNOME"
    }
  },
  "keywords": [],
  "author": {
    "name": "Himel",
    "email": "dev@himelrana.com"
  },
  "license": "ISC",
  "dependencies": {
    "electron-context-menu": "^3.6.1"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  }
}
